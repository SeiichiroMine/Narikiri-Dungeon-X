  <Strings>
    <Section>Story</Section>
    <Entry>
      <PointerOffset>37344</PointerOffset>
      <VoiceId>VCT_004_168_001</VoiceId>
      <JapaneseText>よし！　これでコスチューム全部マスターしたよ！</JapaneseText>
      <EnglishText>Alright! I've mastered all of the costumes!</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>1</Id>
      <BubbleId>1</BubbleId>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>37956</PointerOffset>
      <VoiceId>VCT_004_168_002</VoiceId>
      <JapaneseText>すごいだー！　さすがだー！　かしこいだー！
やっぱ&lt;Mel&gt;&lt;Mel&gt;は、すんばらしい娘っ子だでよ</JapaneseText>
      <EnglishText>Amazing, clever, wickedly smart!
Oh, &lt;Mel&gt;, you really are a magnificent girl~</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>2</Id>
      <BubbleId>1</BubbleId>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>38928</PointerOffset>
      <VoiceId>VCT_004_168_003</VoiceId>
      <JapaneseText>えへへ、ありがとうございます、
アルベルトさん♪</JapaneseText>
      <EnglishText>Hehehe, thank you, Albert!</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>3</Id>
      <BubbleId>1</BubbleId>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>39720</PointerOffset>
      <VoiceId>VCT_004_168_004</VoiceId>
      <JapaneseText>きゅっほーーーん∀　&lt;Mel&gt;&lt;Mel&gt;に感謝されただ。
おら、今日と言う日を一生忘れねーだーよ！</JapaneseText>
      <EnglishText>Ayieee~ &lt;Mel&gt; thanked me!
I'll remember this day for the rest of my life~!</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>4</Id>
      <BubbleId>1</BubbleId>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>41184</PointerOffset>
      <VoiceId>VCT_004_168_005</VoiceId>
      <JapaneseText>ったく、見てらんねー……</JapaneseText>
      <EnglishText>Ugh...Get a room...</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>5</Id>
      <BubbleId>1</BubbleId>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>41712</PointerOffset>
      <VoiceId>VCT_004_168_006</VoiceId>
      <JapaneseText>キュルーン……</JapaneseText>
      <EnglishText>Coolooor</EnglishText>
      <Notes/>
      <SpeakerId>4</SpeakerId>
      <Id>6</Id>
      <BubbleId>1</BubbleId>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>42052</PointerOffset>
      <VoiceId>VCT_004_168_007</VoiceId>
      <JapaneseText>何をごちゃごちゃ言ってるだ。おめぇも悔しかったら
サッサとやることやってくるだど</JapaneseText>
      <EnglishText>What're you glaring at? If you're going to be
bitter hurry and get it over with. You're ruining the mood.</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>7</Id>
      <BubbleId>1</BubbleId>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>43140</PointerOffset>
      <VoiceId>VCT_004_168_008</VoiceId>
      <JapaneseText>の〜〜〜、&lt;Mel&gt;&lt;Mel&gt;？　ほんとに頑張ったで、
おらが特別プレゼントあげるだーよ</JapaneseText>
      <EnglishText>Right, &lt;Mel&gt;? Let me give you a present since
you've worked so hard!</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>8</Id>
      <BubbleId>1</BubbleId>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>44240</PointerOffset>
      <VoiceId>VCT_004_168_009</VoiceId>
      <JapaneseText>え、本当に？</JapaneseText>
      <EnglishText>Really?</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>9</Id>
      <BubbleId>1</BubbleId>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>44556</PointerOffset>
      <VoiceId>VCT_004_168_010</VoiceId>
      <JapaneseText>じゃっじゃっじゃ、じゃ〜〜〜ん！　おらの直筆サイン入り、
色紙をプレゼントー！　特別に手形も押してあるでよ</JapaneseText>
      <EnglishText>Tada~ An autograph signed by yours truly!
I've even signed it with my hand print too!</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>10</Id>
      <BubbleId>1</BubbleId>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>46516</PointerOffset>
      <VoiceId>VCT_004_168_011</VoiceId>
      <JapaneseText>あ、ありがとう……アルベルトさん……</JapaneseText>
      <EnglishText>Oh...Th-Thanks...</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>11</Id>
      <BubbleId>1</BubbleId>
      <Status>Editing</Status>
    </Entry>
  </Strings>
</SceneText>
